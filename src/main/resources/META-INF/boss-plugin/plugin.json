{
  "manifestVersion": 1,
  "pluginId": "ai.rever.boss.plugin.dynamic.flowtab",
  "displayName": "Flow",
  "version": "1.0.0",
  "apiVersion": "1.0.75",
  "minApiVersion": "1.0.75",
  "minBossVersion": "9.2.63",
  "dependencies": [
    {
      "pluginId": "ai.rever.boss.plugin.dynamic.aigateway",
      "version": ">=1.0.3",
      "optional": true
    }
  ],
  "mainClass": "ai.rever.boss.plugin.dynamic.flowtab.FlowTabDynamicPlugin",
  "type": "tab",
  "systemPlugin": false,
  "loadPriority": 50,
  "canUnload": true,
  "tab": {
    "typeId": "flow",
    "displayName": "Flow"
  },
  "panel": {
    "position": "left_bottom",
    "priority": 50
  },
  "description": "Node-based flow canvas — spawn nodes and connect them with edges, n8n style.",
  "author": "Risa Labs",
  "url": "https://github.com/risa-labs-inc/boss-plugin-flow-tab",
  "sandbox": {
    "maxThreads": 4,
    "maxRestartAttempts": 3,
    "heartbeatIntervalMs": 5000
  },
  "isolationMode": "out-of-process",
  "fallback": "in-process",
  "stateHolderClass": "ai.rever.boss.plugin.runtime.stateholders.FlowStateHolder"
}
